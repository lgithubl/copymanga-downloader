FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080 \
    DATA_DIR=/data

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg imagemagick unzip unar \
  && rm -rf /var/lib/apt/lists/*

# parse5 是 web/ 下唯一的 npm 依赖（EPUB 朗读分句用），先单独装，改业务代码不会让这层缓存失效
COPY web/package.json web/package-lock.json ./web/
RUN cd web && npm ci --omit=dev --no-audit --no-fund

COPY web ./web
COPY scripts/tag-scripts /opt/copymanga/tag-scripts

RUN mkdir -p /data/downloads

EXPOSE 8080
VOLUME ["/data"]

CMD ["node", "web/server.mjs"]
