FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080 \
    DATA_DIR=/data \
    NODE_HEAP_MB=8192

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg imagemagick unzip unar \
  && rm -rf /var/lib/apt/lists/*

# web/ 下的 npm 依赖：parse5（EPUB 朗读分句）、sharp（Gal 卡片 / 画廊的图片缩略图；预编译二进制随 npm 包的平台可选依赖装好，Debian glibc 直接可用）。先单独装，改业务代码不会让这层缓存失效
COPY web/package.json web/package-lock.json ./web/
RUN cd web && npm ci --omit=dev --no-audit --no-fund

COPY web ./web
# Spine 3.8 官方 Web 运行时（Gal 播放器渲染 Spine 用；许可证限制，不进仓库，构建时按固定提交下载并校验）
COPY scripts/fetch-spine-runtime.sh /tmp/fetch-spine-runtime.sh
# FreeMote SDK 的 WebGL 引擎（E-mote 立绘；CC BY-NC-SA 4.0 / LGPLv3，不进仓库，构建时下载；下载失败不让构建失败，播放器退回静态立绘）
COPY scripts/fetch-emote-runtime.sh /tmp/fetch-emote-runtime.sh
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
  && sh /tmp/fetch-spine-runtime.sh /app/web/static/vendor \
  && (sh /tmp/fetch-emote-runtime.sh /app/web/static/vendor || echo 'E-mote 运行时没下载到：E-mote 立绘不可用（退回静态立绘）') \
  && rm -rf /var/lib/apt/lists/* /tmp/fetch-spine-runtime.sh /tmp/fetch-emote-runtime.sh
COPY scripts/tag-scripts /opt/copymanga/tag-scripts
# Packed RPG resources share the read-only EVB parser with the standalone tag.
# The server's relative import requires this file under /app as well.
COPY scripts/tag-scripts/gal-layout/evb.mjs ./scripts/tag-scripts/gal-layout/evb.mjs
# Shared FSB5 decoder/data already used by the download tag; no runtime downloads.
COPY scripts/tag-scripts/gal-download/fsb5.mjs ./scripts/tag-scripts/gal-download/fsb5.mjs
COPY scripts/tag-scripts/gal-download/vendor/vorbis-headers.bin.gz ./scripts/tag-scripts/gal-download/vendor/vorbis-headers.bin.gz
# Fail during build if the production tree misses a server import.
RUN node --input-type=module -e "await import('./web/library/types/gal.mjs')"
# Every registered playback adapter must be selectable in the import preset UI.
RUN node --input-type=module -e "import assert from 'node:assert/strict'; import {GAL_PRESETS} from './web/static/gal-import-presets.js'; import {galAdapterIds} from './web/library/gal/adapters/index.mjs'; for (const p of Object.values(GAL_PRESETS)) { assert.ok(p.label && p.game?.id && p.adapters?.length); } assert.deepEqual([...new Set(Object.values(GAL_PRESETS).flatMap(p => p.adapters))].sort(), galAdapterIds().sort());"

RUN mkdir -p /data/downloads

EXPOSE 8080
VOLUME ["/data"]

# Node 默认老生代堆上限约 4GB，和机器内存无关；几十万条的媒体库索引要把它调大（环境变量 NODE_HEAP_MB，单位 MB）
# 只取数字：环境变量里手滑多打的空格、引号（比如 "24576 "）不会让 node 因为非法参数起不来；清洗后为空就不带这个参数
CMD ["sh", "-c", "H=$(printf %s \"$NODE_HEAP_MB\" | tr -dc 0-9); exec node ${H:+--max-old-space-size=$H} web/server.mjs"]
