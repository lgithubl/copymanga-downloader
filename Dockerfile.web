FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080 \
    DATA_DIR=/data

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends imagemagick unzip unar \
  && rm -rf /var/lib/apt/lists/*

COPY web ./web

RUN mkdir -p /data/downloads

EXPOSE 8080
VOLUME ["/data"]

CMD ["node", "web/server.mjs"]
