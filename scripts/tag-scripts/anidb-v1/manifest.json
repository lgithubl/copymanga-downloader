{
  "id": "anidb-v1",
  "name": "AniDB v1",
  "version": "1.2.0",
  "description": "用 AniDB 标题 dump 匹配作品身份（workKey），可选调用 AniDB HTTP API 补元数据。可选的 titleEncoding / titleRewrite 只影响喂给 dump 的匹配串。",
  "scope": [
    "item"
  ],
  "libraryTypes": [
    "media"
  ],
  "mediaKinds": [
    "video",
    "audio"
  ],
  "exclusiveTagGroups": [
    "AniDB",
    "AniDBAPI",
    "ANI类型",
    "ANI集数",
    "ANI年份",
    "ANI季度"
  ],
  "defaultEnabled": false,
  "main": "main.js",
  "options": {
    "dumpDir": "",
    "matchThreshold": null,
    "force": false,
    "apiEnabled": false,
    "apiBaseUrl": "",
    "apiClient": "",
    "apiClientVer": "",
    "apiCacheDir": "",
    "apiSleepBaseMs": null,
    "apiSleepJitterMs": null,
    "apiTimeoutMs": null,
    "scriptTimeoutMs": 600000,
    "titleEncoding": "auto",
    "titleRewrite": [
      {
        "pattern": "\\[[^\\]]*\\]",
        "flags": "g",
        "replace": " "
      },
      {
        "pattern": "【[^】]*】",
        "flags": "g",
        "replace": " "
      },
      {
        "pattern": "（[^）]*）",
        "flags": "g",
        "replace": " "
      },
      {
        "pattern": "\\([^)]*\\)",
        "flags": "g",
        "replace": " "
      },
      {
        "pattern": "\\{[^}]*\\}",
        "flags": "g",
        "replace": " "
      },
      {
        "pattern": "〔[^〕]*〕",
        "flags": "g",
        "replace": " "
      },
      {
        "pattern": "[_.]+",
        "flags": "g",
        "replace": " "
      },
      {
        "pattern": "\\s+",
        "flags": "g",
        "replace": " "
      }
    ],
    "matchMode": "exact",
    "prefixMinChars": 5,
    "prefixMinSegments": 2,
    "prefixRunnerUpRatio": 0
  }
}