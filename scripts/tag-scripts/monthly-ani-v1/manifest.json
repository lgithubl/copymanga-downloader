{
  "id": "monthly-ani-v1",
  "name": "月度 ANI v1",
  "version": "1.0.0",
  "description": "给月度 ANI 导入的合集打上来源 tag。目前只产出「导入: 月度ani」，番剧元数据后续在此扩展。",
  "scope": ["item"],
  "libraryTypes": ["media"],
  "mediaKinds": ["video"],
  "exclusiveTagGroups": ["导入"],
  "defaultEnabled": false,
  "main": "main.js",
  "options": {
    "tagPrefix": "导入",
    "tagValue": "月度ani",
    "dryRun": false,
    "scriptTimeoutMs": 600000
  }
}
