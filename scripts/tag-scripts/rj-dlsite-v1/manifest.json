{
  "id": "rj-dlsite-v1",
  "name": "RJ / DLsite v1",
  "version": "1.0.7",
  "description": "从媒体文件名、目录和标题提取 RJ/VJ/BJ/EJ 编号，并尝试从 DLsite 获取作品 tag。",
  "scope": ["item"],
  "libraryTypes": ["media"],
  "exclusiveTagGroups": [
    "RJ生成",
    "编号",
    "多编号",
    "DL状态",
    "DL年龄",
    "DL类型",
    "DL发售日"
  ],
  "defaultEnabled": false,
  "main": "main.js",
  "options": {
    "site": "auto",
    "cacheTtlHours": 168,
    "cacheOnly": false,
    "scriptTimeoutMs": 300000,
    "fetchAjax": true,
    "fetchHtml": true,
    "requestMinIntervalMs": 800,
    "requestJitterMs": 400,
    "requestTimeoutMs": 20000,
    "requestMaxRetries": 2,
    "requestRetryBaseMs": 1500,
    "requestRetryMaxMs": 60000,
    "respectRetryAfter": true,
    "preferOriginalWork": true,
    "includeKinds": [],
    "excludeKinds": [],
    "includeTags": [],
    "excludeTags": []
  }
}
