{
  "id": "ai-translate-subtitle-v1",
  "name": "AI 字幕翻译 v1",
  "version": "1.3.0",
  "description": "调用 local-llm-server 翻译 AI.jp 字幕为 AI.zh 字幕，并写入显式字幕映射。",
  "scope": ["item", "unit"],
  "libraryTypes": ["media"],
  "mediaKinds": ["audio", "video"],
  "exclusiveTagGroups": ["字幕v1", "AI字幕", "AI翻译version"],
  "defaultEnabled": false,
  "main": "main.js",
  "options": {
    "apiBase": "http://127.0.0.1:8080",
    "model": "sakura",
    "sourceTitlePrefix": "AI.jp",
    "targetTitle": "AI.zh",
    "sourceLanguage": "ja",
    "targetLanguage": "zh",
    "outputFormat": "srt",
    "outputDir": "ai-subtitles",
    "force": false,
    "batchSize": 15,
    "contextSize": 2,
    "maxLenRatio": 3,
    "minLenCheckChars": 20,
    "maxRequestFactor": 2,
    "retryOnSuspiciousLength": true,
    "reportMode": "onIssue",
    "requestTimeoutMs": 600000,
    "scriptTimeoutMs": 86400000,
    "prompt": "将下面的日文字幕逐条翻译成简体中文。保持口语化和角色语气，不要添加原文没有的解释或注释。"
  }
}
