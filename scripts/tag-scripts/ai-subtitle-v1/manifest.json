{
  "id": "ai-subtitle-v1",
  "name": "AI 字幕 v1",
  "version": "1.1.0",
  "description": "调用 local-asr-server 为无字幕音视频生成 AI 字幕，并写入显式字幕映射。",
  "scope": ["item", "unit"],
  "libraryTypes": ["media"],
  "mediaKinds": ["audio", "video"],
  "exclusiveTagGroups": ["字幕v1", "AI字幕", "AI字幕version"],
  "defaultEnabled": false,
  "main": "main.js",
  "options": {
    "apiBase": "http://192.168.50.56:11594",
    "inputPathFrom": "/data/library/media",
    "inputPathTo": "/inputs/media",
    "outputPathFrom": "/outputs",
    "outputPathTo": "{filesRoot}/ai-subtitles",
    "language": "ja",
    "outputFormat": "srt",
    "segmenter": "asmr-onnx",
    "vadFilter": null,
    "fastMode": true,
    "force": false,
    "overwriteExisting": false,
    "outputDirTemplate": "{itemId}",
    "subtitleTitle": "AI.jp",
    "scriptTimeoutMs": 86400000,
    "requestTimeoutMs": 600000
  }
}
